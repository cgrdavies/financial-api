FINANCIAL_API_TOKEN=
FINANCIAL_PLAID_CLIENT_ID=
FINANCIAL_PLAID_SECRET=
FINANCIAL_PLAID_ENVIRONMENT=sandbox
# JSON array: [{"item_id":"example-item","access_token":"replace-me","institution_name":"Example Bank"}]
