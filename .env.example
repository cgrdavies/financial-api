# Set secrets in Dokploy. Compose interpolates these explicit FINANCIAL_ names.
# For local Compose validation, .env supplies interpolation; the API itself does not load it.
# compose.yaml requires B64; raw JSON / SPENDY_ aliases are direct-container options only.
FINANCIAL_API_TOKEN=
FINANCIAL_PLAID_CLIENT_ID=
FINANCIAL_PLAID_SECRET=
FINANCIAL_PLAID_ENVIRONMENT=sandbox
# Preferred for Dokploy: base64-encoded UTF-8 JSON, one line (not additional encryption).
FINANCIAL_PLAID_ITEMS_B64=
# Fallback when B64 is empty. JSON array: [{"item_id":"example-item","access_token":"replace-me","institution_name":"Example Bank"}]
# For migration, use access_token_encrypted instead and set FINANCIAL_ENCRYPTION_KEY.
FINANCIAL_PLAID_ITEMS_JSON=[]
FINANCIAL_ENCRYPTION_KEY=
